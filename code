function fiche {
    local dir="~/Documents/prepa/sup/fiches/physique"
    cd $dir
    if [ $# -eq 1 ]; then
        if [ $1 = "-h" ]; then
            echo "2 possibilités :"
            echo "- Soit on ne met que le numéro de la fiche comme argument"
            echo "- Soit on met le numéro du premier workspace, de la première et de la dernière fiche à ouvrir"
            echo
            echo "Options :"
            echo "-d : affiche le numéro de la dernière fiche"
            echo "-l : liste toutes les fiches présentes"
            return 0
        elif [ $1 = "-d" ]; then
            ls | grep ".pdf" | tail -n 1
            return 0
        elif [ $1 = "-l" ]; then
            ls | grep -F ".pdf" | tr "\n" " - " | sed 's/chap//g' | sed 's/.pdf//g' && echo
            return 0
        fi
        pdf chap$1.pdf
        pdf cours/chap$1.pdf
    elif [ $# -eq 3 ]; then
        local space=$1
        local num_fiche=$2
        while [ $num_fiche != $(($3+1)) ]
        do
            # echo "num_fiche = $num_fiche"
            # hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = \"$space\" }))"
            hyprctl eval "hl.dispatch(hl.dsp.exec_cmd(\"evince ${dir}/chap${num_fiche}.pdf\", { workspace = \"$space\" }))"
            hyprctl eval "hl.dispatch(hl.dsp.exec_cmd(\"evince ${dir}/cours/chap${num_fiche}.pdf\", { workspace = \"$space\" }))"
            ((num_fiche++))
            ((space++))
        done
    else
        echo "Nombre d'arguments incorrect"
        return 1
    fi
    suicide
}

