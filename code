alias suicide="kill -9 $PPID"

_mx_completion() {
    _files -g '*.(c|ml)'
}
function mx {
    trap 'echo " " && rm -f "$nom_prog".cmi "$nom_prog".cmx "$nom_prog".o nom_prog' INT TERM EXIT
    local exec=1
    local fast="-Ofast"
    local asserts=1
    local valgrind=0
    local presence_args=0
    local args=""
    local OPTIND

    while getopts "f o v c a h" opt; do
        case $opt in
            f) assert=0;;
            o) fast="-O0";;
            v) valgrind=1
               fast="-O0";;
            c) exec=0;;
            a) presence_args=1;;
            h) echo "Utilisation : mx [OPTIONS] [FICHIERS]"
               echo "Options valides :"
               echo "-f : Retire les asserts lors de la compilation"
               echo "-v : Exécute le code dans Valgrind (pour le C)"
               echo "-o : Remplace -03 par -O0 lors de la compilation pour que gcc ne modifie pas le code (pour le C)"
               echo "-c : Ne fait que compiler"
               echo "-a : Passe des arguments au programme lors de l'execution. Mettre des guillemets autour des arguments s'il y en a plusieurs"
               echo "-h : Affiche ce message"
               return 0 ;;
            \?) echo "Option invalide. -h pour la liste des options."
                return 1 ;;
        esac
    done

    shift $((OPTIND - 1))

    if [ $presence_args -eq 1 ]; then
        echo "Saisir le ou les argument(s) : "
        read args
    fi

    case ${1: -1} in
        'c')
            local nom_prog=${1/.c/}
            if [ $asserts -eq 1 ]; then
                asserts=""
            else
                asserts="-DNDEBUG"
            fi
            gcc -Wall -Wextra "${@:1}" $fast $asserts -march=native -mtune=native -flto -lm -g3 -o $nom_prog
            if [ $exec -eq 1 ]; then
                if [ $valgrind -eq 0 ]; then
                    ./"$nom_prog" $args
                else
                    valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes -s ./"$nom_prog" $args
                    if [ -f vgcore.* ]; then
                        rm vgcore.*
                    fi
                fi
                rm $nom_prog
            fi
        ;;
        'l')
            if [ $asserts -eq 1 ]; then
                asserts=""
            else
                asserts="-noassert"
            fi
            local nom_prog=${1/.ml/}
            ocamlopt -g -O3 -inline 40 -nodynlink $asserts -ccopt "-O3 -march=native -mtune=native -flto" -o nom_prog $1
            if [ $exec -eq 1 ]; then
                OCAMLRUNPARAM=b ./nom_prog $args
                rm nom_prog *.cmi *.cmx *.o
            fi
            ;;
        ?)
            echo "mauvais type de fichier"
            return 1;;
    esac
}
compdef _mx_completion mx

function go {
    if [ $# -eq 0 ]; then
        1="-m"
        2="tp"
    fi

    local ouvre=1
    while getopts "m h" opt; do
        case $opt in
            m) ouvre=0;;
            h) echo "Utilisation : go tp 11, go dm 2, go tp_p ..."
               echo "Ouvre le dossier donné en argument (en mettant des majuscules) dans Zed, puis s'il y a un .pdf l'ouvre (il faut qu'il ait le même nom que le dossier)."
               echo "tp correspond aux tp d'info, tp_p à ceux de physique"
               echo "Si aucun nombre n'est donné en entrée, ouvre le dernier DM / TP"
               echo "Options valides :"
               echo "-m : ne fait que se déplacer vers le dossier, sans rien ouvrir"
               return 0 ;;
            \?) echo "option invalide. -h pour la liste des options."
                return 1 ;;
        esac
    done

    shift $((OPTIND - 1))

    local type=$1
    local nb=""
    if [ $# -eq 1 ]; then
        if [ $type = "tp" ]; then
            nb=$(cat ~/.fct/var/der_TP.txt)
        else
            nb=$(cat ~/.fct/var/der_DM.txt)
        fi
    else
        nb=$2
        echo $nb > ~/.fct/var/der_TP.txt
    fi

    case $type in
        'tp')
            z ~/Documents/prepa/spe/info/TP/
            if [ -d TP$nb ]; then
            else mkdir "TP$nb"
            fi

            z TP$nb
            if [ $ouvre -eq 1 ]; then
                zeditor "../TP$nb"
                if [ -f "TP$nb.pdf" ]; then
                    evince "TP$nb.pdf" & disown
                fi
            fi;;
        'tp_p')
            z ~/Documents/prepa/spe/physique/TP/
            if [ -d TP$nb ]; then
            else mkdir "TP$nb"
            fi

            z TP$nb
            if [ $ouvre -eq 1 ]; then
                zeditor "../TP$nb"
                if [ -f "TP$nb.pdf" ]; then
                    evince "TP$nb.pdf" & disown
                fi
            fi;;
        'dm')
            z ~/Documents/prepa/spe/info/DM/
            if [ -d DM$nb ]; then
            else mkdir "TP$nb"
            fi

            z DM$nb
            if [ $ouvre -eq 1 ]; then
                zeditor "../DM$nb"
                if [ -f "DM$nb.pdf" ]; then
                    evince "DM$nb.pdf" & disown
                fi
            fi ;;
        \?) echo "Argument de la mauvaise forme. -h pour l'aide."
            return 1;;
    esac
}

function push {
    local repo="main"
    local change=0
    while getopts "r" opt; do
        case $opt in
            r) repo=$1
               change=1 ;;
            \?) echo "option invalide. -h pour la liste des options."
                return 1 ;;
        esac
    done

    shift $((OPTIND - 1))
    if [ $# -eq 0 ]; then
        echo "Il faut le commentaire !"
        return 1
    fi
    git add .
    echo $change
    if [ $change -eq 0 ]; then
        git commit -m $1
        git push origin main
    else
        git commit -m $2
        git push origin $1
    fi
    return 0
}

function colle {
    z ~/Documents/prepa/spe/Maths/colles
    local num=1
    if [ $# -eq 1 ]; then
        num=$1
    else
        while [ -f "sem${num}.pdf" ]
        do
            let num=$(($num+1))
        done
        let num=$(($num-1))
    fi
    evince sem${num}.pdf & disown
    suicide
}

